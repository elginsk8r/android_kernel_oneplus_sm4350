# Display
CONFIG_DRM_OPLUS_NOTIFY=y

# Filesystem
CONFIG_EXFAT_FS=y

# Logging
CONFIG_LOG_CPU_MAX_BUF_SHIFT=17
CONFIG_LOG_BUF_SHIFT=21

# Network
CONFIG_OPLUS_FEATURE_WIFI_MAC=y

# Power
CONFIG_OPLUS_FEATURE_CHG_MISC=y

# Sensors
CONFIG_OPLUS_SENSOR_FB_QC=y

# SIM Detect
CONFIG_SIM_DETECT=y
